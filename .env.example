# ==============================================================================
# GREEK FIT KITCHEN — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: Never commit actual secret keys to public source control.
# Copy this file to .env.local for development or configure securely in production hosting.

# 1. CORE APPLICATION & BRANDING
APP_NAME="Greek Fit Kitchen"
APP_URL="https://greekfitkitchen.ca"
APP_ENV="production"
NODE_ENV="production"
PORT=3000

# 2. BUSINESS LOCATION & CONTACT
BUSINESS_MANAGER="George the Greek"
PICKUP_ADDRESS="3575 Lake Shore Blvd W, Etobicoke, ON M8W 1P5, Canada"
CONTACT_PHONE="+1-416-555-0199"
CONTACT_EMAIL="orders@greekfitkitchen.ca"
POWERED_BY="Lean Meal (leanmeal.ca)"

# 3. TIMEZONE & CUTOFF SCHEDULER
# Timezone identifier must follow IANA format for accurate Ontario daylight saving time handling
BUSINESS_TIMEZONE="America/Toronto"
SUNDAY_DELIVERY_CUTOFF_DAY="Friday"
SUNDAY_DELIVERY_CUTOFF_TIME="12:00" # 12:00 PM noon
WEDNESDAY_DELIVERY_CUTOFF_DAY="Monday"
WEDNESDAY_DELIVERY_CUTOFF_TIME="12:00" # 12:00 PM noon

# 4. DELIVERY PRICING ENGINE
# Flyer pricing rule: $5.99 base + $0.99 per km
DELIVERY_BASE_FEE_CAD=5.99
DELIVERY_PER_KM_RATE_CAD=0.99
MAX_DELIVERY_RADIUS_KM=45.0
ORIGIN_COORDINATES_LAT="43.5937"
ORIGIN_COORDINATES_LNG="-79.5284"

# 5. TAX CONFIGURATION
# Ontario Harmonized Sales Tax (HST) is 13%
TAX_JURISDICTION="Ontario, Canada"
TAX_RATE_HST=0.13
TAX_INCLUSIVE_PRICING=false

# 6. PROMOTIONS & VOLUME DISCOUNT RULES
MIN_MEAL_ORDER_QUANTITY=6
MIN_MEAL_STARTING_PRICE_CAD=59.94
VOLUME_DISCOUNT_THRESHOLD_MEALS=7
VOLUME_DISCOUNT_PERCENTAGE=10.0
EXTRA_SIDE_PRICE_CAD=4.99

# 7. STRIPE PAYMENT GATEWAY (TEST & LIVE KEYS)
# Obtain from your Stripe Dashboard (Developers > API keys)
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key_here"
STRIPE_SECRET_KEY="sk_test_placeholder_secret_here"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_webhook_secret_here"
CURRENCY="cad"

# 8. MAPPING & GEOCODING API
# Google Maps Platform Geocoding & Distance Matrix API
GOOGLE_MAPS_API_KEY="AIzaSyPlaceholderKeyForDistanceMatrixCalculation"

# 9. TRANSACTIONAL EMAIL PROVIDER
# SendGrid / Resend / AWS SES credentials for customer receipts & kitchen notifications
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="SG.placeholder_smtp_password_here"
EMAIL_FROM="Greek Fit Kitchen <orders@greekfitkitchen.ca>"
KITCHEN_ALERT_EMAIL="kitchen@georgethegreek.ca"
